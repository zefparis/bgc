# ─────────────────────────────────────────────────────────────
# BGC Holding — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit secrets.
# All features degrade safely when variables are absent.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://bgcholding.com

# ── Contact form ─────────────────────────────────────────────
# Resend API key (https://resend.com) — server-side only.
# If unset, POST /api/contact returns 503 and the client falls
# back to a mailto: link (contact data is never silently dropped).
RESEND_API_KEY=

# Verified sender and destination addresses for contact email.
CONTACT_FROM=BGC Holding Website <noreply@bgcholding.com>
CONTACT_TO=info@bgcholding.com

# ── Spam protection (Cloudflare Turnstile) ────────────────────
# Public site key — safe to expose (NEXT_PUBLIC_*).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key — server-side only. If unset, the API route treats
# the service as unconfigured (503) rather than skipping checks.
TURNSTILE_SECRET_KEY=
